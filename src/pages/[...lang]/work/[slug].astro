---
import { Image } from "astro:assets";
import regmaisImage from "../../../assets/regmais-allocation.png";
import Badge from "../../../components/Badge.astro";
import Flow from "../../../components/Flow.astro";
import Link from "../../../components/Link.astro";
import StudyBrainEvidence from "../../../components/StudyBrainEvidence.astro";
import { getText } from "../../../content/index";
import { type Project, getProjects } from "../../../content/projects";
import { type Locale, localeParams, localePath } from "../../../i18n/locales";
import Base from "../../../layouts/Base.astro";
export function getStaticPaths() {
  return localeParams().flatMap(({ params, props }) =>
    getProjects(props.locale).map((project) => ({
      params: { ...params, slug: project.slug },
      props: { ...props, project },
    })),
  );
}
interface Props {
  readonly locale: Locale;
  readonly project: Project;
}
const { locale, project } = Astro.props;
const t = getText(locale).caseStudy;
const projects = getProjects(locale);
---
<Base title={`${project.name} — ${t.titleSuffix} | João Paulo Navarro`} description={project.summary} locale={locale} path={`/work/${project.slug}/`}>
  <article class="container case-study">
    <a class="back-link" href={`${localePath(locale)}#work`}>{t.back}</a>
    <header class="case-header"><p class="eyebrow">{t.eyebrow} {project.number} / {project.domain}</p><h1 class="display">{project.name}</h1><p class="lead case-deck">{project.headline}</p><Badge tone={project.tone}>{project.status}</Badge></header>
    <div class="case-meta"><div><p class="eyebrow">{t.contribution}</p><p>{project.responsibility}</p></div><div><p class="eyebrow">{t.stack}</p><ul class="tech-list">{project.stack.map(item => <li>{item}</li>)}</ul></div></div>
    <div class="case-body"><section><h2 class="section-title">{t.problem}</h2><p class="lead">{project.problem}</p></section><aside class="evidence-note"><p class="eyebrow">{t.question}</p><p>{project.discussion}</p></aside></div>
    <section class="case-section"><p class="eyebrow">{t.structureEyebrow}</p><h2 class="section-title">{t.structureTitle}</h2><p>{project.architecture}</p><Flow steps={project.steps} caption={project.flowCaption} /></section>
    <section class="case-section" aria-labelledby="decisions"><h2 class="section-title" id="decisions">{t.decisions}</h2><div class="decision-list">{project.decisions.map((decision,index) => <article><span class="eyebrow">0{index+1}</span><div><h3>{decision.title}</h3><p>{decision.body}</p></div></article>)}</div></section>
    {project.slug === 'regmais' && <figure class="interface-capture"><Image src={regmaisImage} alt={t.regmaisAlt} widths={[640,960,1280]} sizes="(max-width: 768px) 90vw, 1100px" format="webp" loading="lazy" /><figcaption class="small muted">{t.regmaisCaption}</figcaption></figure>}
    <section class="case-section case-body"><div><h2 class="section-title">{t.verification}</h2><p>{project.verification}</p><p class="muted">{project.limitation}</p></div>{project.sourceHref ? <aside class="evidence-note"><p class="eyebrow">{t.sourceEyebrow}</p><p>{t.sourcePublic}</p><Link href={project.sourceHref}>{t.sourceRead}</Link></aside> : <aside class="evidence-note"><p class="eyebrow">{t.sourceEyebrow}</p><p>{t.sourcePrivate}</p><Link href={`${localePath(locale)}#contact`}>{t.discuss}</Link></aside>}</section>
    {project.slug === "study-brain" && <StudyBrainEvidence locale={locale} />}
    <nav class="case-next" aria-label={t.otherCases}><p class="eyebrow">{t.keepExploring}</p>{projects.filter(item => item.slug !== project.slug).map(item => <Link href={localePath(locale, `/work/${item.slug}/`)}>{item.name} →</Link>)}</nav>
  </article>
</Base>
