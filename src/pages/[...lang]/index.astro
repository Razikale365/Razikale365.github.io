---
import Badge from "../../components/Badge.astro";
import Flow from "../../components/Flow.astro";
import Lines from "../../components/Lines.astro";
import Link from "../../components/Link.astro";
import { getText } from "../../content/index";
import { getOpenWork } from "../../content/open-work";
import { profile } from "../../content/profile";
import { getProjects } from "../../content/projects";
import { type Locale, localeParams, localePath } from "../../i18n/locales";
import Base from "../../layouts/Base.astro";
export const getStaticPaths = localeParams;
interface Props {
  readonly locale: Locale;
}
const { locale } = Astro.props;
const text = getText(locale);
const t = text.home;
const projects = getProjects(locale);
const openWork = getOpenWork(locale);
const work = (slug: string) => localePath(locale, `/work/${slug}/`);
const resume = localePath(locale, "/resume/");
---
<Base title={t.title} description={t.description} locale={locale} path="/">
  <section class="hero container" aria-labelledby="hero-title">
    <div><p class="eyebrow">{text.profile.role}</p><h1 class="display" id="hero-title"><Lines lines={t.heroTitle} /></h1><p class="lead hero-intro">{t.intro}</p><ul class="proof-list">{t.proof.map(item => <li>{item}</li>)}</ul><p class="muted">{t.introDetail}</p><div class="actions"><Link href="#work" variant="button">{t.explore} <span aria-hidden="true">↓</span></Link><Link href={resume}>{t.viewResume}</Link></div><p class="availability small">{text.profile.location} <span aria-hidden="true">/</span> {t.availability}</p></div>
    <aside class="work-index" aria-label={t.indexLabel}><p class="eyebrow">{t.indexEyebrow}</p><p class="index-intro"><Lines lines={t.indexIntro} /></p><ol>{projects.map(project => <li><a href={work(project.slug)}><span class="index-number">{project.number}</span><span><strong>{project.name}</strong><small>{project.domain}</small></span><span aria-hidden="true">↗</span></a></li>)}</ol><p class="eyebrow index-open-label">{t.indexOpen}</p><ul class="index-open">{openWork.slice(0, 2).flatMap(item => item.links.slice(0, 1).map(link => <li><a href={link.href}>{item.name} <span aria-hidden="true">↗</span></a></li>))}</ul><p class="small muted index-note"><Lines lines={t.indexNote} /></p></aside>
  </section>
  <section class="container section" aria-labelledby="open-title"><p class="eyebrow">{t.openEyebrow}</p><h2 class="section-title" id="open-title">{t.openTitle}</h2><p class="muted">{t.openIntro}</p><div class="additional-grid">{openWork.map(item => <article><p class="eyebrow">{item.domain}</p><h3>{item.name}</h3><p class="muted">{item.description}</p><p class="open-links">{item.links.map(link => <Link href={link.href}>{link.label} ↗</Link>)}</p></article>)}</div></section>
  <section class="container section" id="work" aria-labelledby="work-title">
    <div class="section-heading"><div><p class="eyebrow">{t.workEyebrow}</p><h2 class="section-title" id="work-title">{t.workTitle}</h2></div><p class="muted"><Lines lines={t.workIntro} /></p></div>
    {projects.map(project => <article class={`project-row project-${project.slug}`}><div class="project-copy"><p class="eyebrow">{project.number} / {project.domain}</p><h3><a href={work(project.slug)}>{project.name} <span aria-hidden="true">↗</span></a></h3><Badge tone={project.tone}>{project.status}</Badge><p class="project-headline">{project.headline}</p><p class="muted">{project.summary}</p><ul class="tech-list" aria-label={t.technologies(project.name)}>{project.stack.map(item => <li>{item}</li>)}</ul><Link href={work(project.slug)}>{t.readCase(project.name)}</Link></div><div class="project-figure"><p class="eyebrow">{t.insideSystem}</p><Flow steps={project.steps} caption={project.flowCaption} /></div></article>)}
  </section>
  <section class="capabilities-band" aria-labelledby="approach-title"><div class="container section"><p class="eyebrow">{t.approachEyebrow}</p><h2 class="section-title" id="approach-title">{t.approachTitle}</h2><div class="capabilities-grid">{t.approach.map((item, index) => <article><span class="cap-number">{"ABC"[index]}</span><h3>{item.title}</h3><p>{item.body}</p><a href={work(item.slug)}>{item.link}</a></article>)}</div></div></section>
  <section class="container section" aria-labelledby="more-title"><p class="eyebrow">{t.moreEyebrow}</p><h2 class="section-title" id="more-title">{t.moreTitle}</h2><div class="additional-grid"><article><p class="eyebrow">{t.bulldog.domain}</p><h3>{t.bulldog.name}</h3><p class="muted">{t.bulldog.description}</p><Link href="#contact">{t.bulldog.linkLabel}</Link></article></div></section>
  <section class="container section about" aria-labelledby="about-title"><div><p class="eyebrow">{t.aboutEyebrow}</p><h2 class="section-title" id="about-title"><Lines lines={t.aboutTitle} /></h2></div><div><p class="lead">{t.aboutLead}</p>{t.aboutBody.map(paragraph => <p class="muted">{paragraph}</p>)}<Link href={resume}>{t.aboutLink}</Link></div></section>
  <section class="container contact section" id="contact" aria-labelledby="contact-title"><p class="eyebrow">{t.contactEyebrow}</p><h2 class="section-title" id="contact-title">{t.contactTitle}</h2><p class="lead">{t.contactLead}</p><div class="actions"><Link href={`mailto:${profile.email}`} variant="button">{profile.email}</Link><Link href={profile.linkedin}>LinkedIn ↗</Link><Link href={resume}>{t.contactResume}</Link></div><p class="small muted">{t.contactNote}</p></section>
</Base>
