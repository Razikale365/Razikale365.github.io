---
import Badge from "../components/Badge.astro";
import Flow from "../components/Flow.astro";
import Link from "../components/Link.astro";
import { profile } from "../content/profile";
import { additionalProjects, projects } from "../content/projects";
import Base from "../layouts/Base.astro";
---
<Base title="João Navarro — Full-Stack / Applied AI Engineer" description="Full-stack and applied AI engineer building operational software and document-intelligence systems. Explore data integrity, evidence-grounded retrieval and operator workflows.">
  <section class="hero container" aria-labelledby="hero-title">
    <div><p class="eyebrow">Full-Stack / Applied AI Engineer</p><h1 class="display" id="hero-title">Real workflows.<br />Thoughtful systems.</h1><p class="lead hero-intro">I’m João. I build operational software and AI systems that make complex information usable and decisions traceable.</p><p class="muted">Five years building web applications and data workflows. From rules that protect a stock movement to sources a reader can inspect behind an AI answer.</p><div class="actions"><Link href="#work" variant="button">Explore selected work <span aria-hidden="true">↓</span></Link><Link href="/resume/">View résumé ↗</Link></div><p class="availability small">{profile.location} <span aria-hidden="true">/</span> Remote & European opportunities</p></div>
    <aside class="work-index" aria-label="Selected systems"><p class="eyebrow">An engineer’s fieldnotes</p><p class="index-intro">The rule behind<br />the interface.</p><ol>{projects.map(project => <li><a href={`/work/${project.slug}/`}><span class="index-number">{project.number}</span><span><strong>{project.name}</strong><small>{project.domain}</small></span><span aria-hidden="true">↗</span></a></li>)}</ol><p class="small muted index-note">Domain models. Deliberate boundaries.<br />Software you can reason about.</p></aside>
  </section>
  <section class="container section" id="work" aria-labelledby="work-title">
    <div class="section-heading"><div><p class="eyebrow">01 / Selected work</p><h2 class="section-title" id="work-title">Built around the problem.</h2></div><p class="muted">Three systems. Different domains.<br />A shared focus on reliable decisions.</p></div>
    {projects.map(project => <article class={`project-row project-${project.slug}`}><div class="project-copy"><p class="eyebrow">{project.number} / {project.domain}</p><h3><a href={`/work/${project.slug}/`}>{project.name} <span aria-hidden="true">↗</span></a></h3><Badge tone={project.tone}>{project.status}</Badge><p class="project-headline">{project.headline}</p><p class="muted">{project.summary}</p><ul class="tech-list" aria-label={`${project.name} technologies`}>{project.stack.map(item => <li>{item}</li>)}</ul><Link href={`/work/${project.slug}/`}>Read the {project.name} case study →</Link></div><div class="project-figure"><p class="eyebrow">Inside the system</p><Flow steps={project.steps} caption={project.flowCaption} /></div></article>)}
  </section>
  <section class="capabilities-band" aria-labelledby="approach-title"><div class="container section"><p class="eyebrow">02 / Engineering approach</p><h2 class="section-title" id="approach-title">The useful work is in the decisions.</h2><div class="capabilities-grid"><article><span class="cap-number">A</span><h3>Model the rules.</h3><p>Authorization, stock, capacity and history deserve explicit models. The backend should protect the rules the interface promises.</p><a href="/work/dispensamais/">See the dispensing boundary →</a></article><article><span class="cap-number">B</span><h3>Make actions understandable.</h3><p>Preview consequential changes. Explain empty and failure states. Let the operator understand a decision before committing it.</p><a href="/work/regmais/">See the allocation workflow →</a></article><article><span class="cap-number">C</span><h3>Make answers inspectable.</h3><p>Carry source text and page references through ingestion, retrieval and model output. Verify the evidence against the document it came from.</p><a href="/work/fiscal-brain/">See the document-to-evidence path →</a></article></div></div></section>
  <section class="container section" aria-labelledby="more-title"><p class="eyebrow">03 / Further exploration</p><h2 class="section-title" id="more-title">A wider engineering toolkit.</h2><div class="additional-grid">{additionalProjects.map(project => <article><p class="eyebrow">{project.domain}</p><h3>{project.name}</h3><p class="muted">{project.description}</p><Link href={project.href}>{project.linkLabel} ↗</Link></article>)}</div></section>
  <section class="container section about" aria-labelledby="about-title"><div><p class="eyebrow">04 / Professional context</p><h2 class="section-title" id="about-title">Close to the domain.<br />Across the stack.</h2></div><div><p class="lead">I work on software that supports the everyday operations of real organizations.</p><p class="muted">At DemandaNet, I’ve worked on education-management workflows, relational data migrations and product modules since 2021. My independent projects extend that practice into municipal services and evidence-grounded document intelligence.</p><p class="muted">Python, TypeScript and SQL connect much of this work. I choose the rest around the problem, the people using the software and the cost of maintaining it.</p><Link href="/resume/">Experience & résumé →</Link></div></section>
  <section class="container contact section" id="contact" aria-labelledby="contact-title"><p class="eyebrow">Let’s talk about the work</p><h2 class="section-title" id="contact-title">Have a problem worth building for?</h2><p class="lead">I’m interested in full-stack, backend and applied AI roles where I can own meaningful parts of a product.</p><div class="actions"><Link href={`mailto:${profile.email}`} variant="button">{profile.email} ↗</Link><Link href={profile.linkedin}>LinkedIn ↗</Link><Link href="/resume/">Résumé →</Link></div><p class="small muted">Based in Brazil. Open to international remote work and European relocation.</p></section>
</Base>
