---
import { Image } from "astro:assets";
import ingestion from "../assets/fiscal-brain/ingestion-complete.webp";
import mobile from "../assets/fiscal-brain/mobile-evidence.webp";
import tutor from "../assets/fiscal-brain/tutor-evidence.webp";
import { getText } from "../content/index";
import type { Locale } from "../i18n/locales";
import Link from "./Link.astro";
interface Props {
  readonly locale: Locale;
}
const t = getText(Astro.props.locale).fiscalEvidence;
---
<section class="case-section" aria-labelledby="golden-demo">
  <p class="eyebrow">{t.eyebrow}</p>
  <h2 class="section-title" id="golden-demo">{t.title}</h2>
  <p>{t.introBefore} <strong lang="en">“SYNTHETIC TEST CONTENT — NOT REAL BRAZILIAN LAW.”</strong> {t.introAfter}</p>
  <figure class="interface-capture evidence-desktop">
    <a href={tutor.src} aria-label={t.tutorLabel}><Image src={tutor} alt={t.tutorAlt} widths={[480, 791]} sizes="(max-width: 900px) 90vw, 791px" format="webp" quality={90} loading="lazy" /></a>
    <figcaption class="small muted">{t.tutorCaption}</figcaption>
  </figure>
  <div class="evidence-gallery">
    <figure class="interface-capture">
      <a href={ingestion.src} aria-label={t.ingestionLabel}><Image src={ingestion} alt={t.ingestionAlt} widths={[640, 1078]} sizes="(max-width: 768px) 90vw, 740px" format="webp" quality={90} loading="lazy" /></a>
      <figcaption class="small muted">{t.ingestionCaption}</figcaption>
    </figure>
    <figure class="interface-capture evidence-mobile">
      <a href={mobile.src} aria-label={t.mobileLabel}><Image src={mobile} alt={t.mobileAlt} widths={[320, 390]} sizes="(max-width: 390px) 90vw, 320px" format="webp" quality={90} loading="lazy" /></a>
      <figcaption class="small muted">{t.mobileCaption}</figcaption>
    </figure>
  </div>
  <p class="small"><Link href="/evidence/fiscal-brain-golden-demo.pdf">{t.pdfLink}</Link><br /><Link href="/evidence/fiscal-brain-evidence.json">{t.jsonLink}</Link></p>
</section>
