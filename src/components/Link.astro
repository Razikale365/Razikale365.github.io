---
interface Props {
  readonly href: string;
  readonly label?: string;
  readonly variant?: "inline" | "nav" | "button";
}

const { href, label, variant = "inline" } = Astro.props;
---

<a class:list={['link', `link--${variant}`]} href={href}>
  {label ?? <slot />}
</a>

<style>
  .link { font-weight: 500; }
  .link--inline { text-decoration-thickness: 1px; }
  .link--nav { color: var(--ink); text-decoration: none; }
  .link--nav:hover { color: var(--accent); text-decoration: underline; text-underline-offset: 0.3em; }
  .link--button { align-items: center; background: var(--accent); border-radius: 4px; color: var(--surface); display: inline-flex; min-height: 44px; padding: var(--s2) var(--s4); text-decoration: none; }
  .link--button:hover { background: var(--accent-hover); color: var(--surface); }
  .link--button:active { background: var(--ink); }
</style>

